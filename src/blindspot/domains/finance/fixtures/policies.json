[
  {"entity_id": "policy_payment_controls", "schema_version": "1.0.0", "created_at": "2026-01-01T00:00:00+00:00", "updated_at": "2026-01-01T00:00:00+00:00", "title": "Payment Controls Policy", "domain": "finance", "rules": [{"rule_id": "no_self_approval", "description": "Employees may not approve their own payment initiations.", "effect": "deny", "action_pattern": "approve", "subject_conditions": {"is_payment_initiator": true}, "priority": 200, "enabled": true}, {"rule_id": "dual_control_large_transfers", "description": "Transfers over $50,000 require two separate approvers.", "effect": "require_approval", "action_pattern": "initiate", "context_conditions": {"amount_usd_gt": 50000}, "priority": 150, "enabled": true}, {"rule_id": "require_verification_large_exec", "description": "Transfers over $500,000 require executive sign-off.", "effect": "require_verification", "action_pattern": "initiate", "context_conditions": {"amount_usd_gt": 500000}, "priority": 250, "enabled": true}]},
