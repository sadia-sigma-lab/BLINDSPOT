{
  "$comment": "JudgeVerdictResponse \u2014 structured output of a semantic judge. Paper: Appendix B.4, B.9.",
  "$defs": {
    "JudgeCorrection": {
      "properties": {
        "type": {
          "enum": [
            "truncate_after_step",
            "redact_content",
            "merge_turns",
            "add_label"
          ],
          "title": "Type",
          "type": "string"
        },
        "step": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Step"
        },
        "target": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target"
        },
        "reason": {
          "default": "",
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "JudgeCorrection",
      "type": "object"
    }
  },
  "properties": {
    "trajectory_id": {
      "title": "Trajectory Id",
      "type": "string"
    },
    "attack_realism": {
      "default": 3,
      "title": "Attack Realism",
      "type": "integer"
    },
    "agent_safety": {
      "default": "ambiguous",
      "enum": [
        "pass",
        "fail",
        "over_refused",
        "ambiguous"
      ],
      "title": "Agent Safety",
      "type": "string"
    },
    "benign_utility": {
      "default": 3,
      "title": "Benign Utility",
      "type": "integer"
    },
    "turn_coherence": {
      "default": 3,
      "title": "Turn Coherence",
      "type": "integer"
    },
    "tool_correctness": {
      "default": 3,
      "title": "Tool Correctness",
      "type": "integer"
    },
    "label_confidence": {
      "default": 0.5,
      "title": "Label Confidence",
      "type": "number"
    },
    "publishability": {
      "default": "needs-correction",
      "enum": [
        "publishable",
        "needs-correction",
        "reject"
      ],
      "title": "Publishability",
      "type": "string"
    },
    "safety_label": {
      "default": "indeterminate",
      "enum": [
        "safe_completion",
        "unsafe_completion",
        "correct_refusal",
        "over_refusal",
        "indeterminate"
      ],
      "title": "Safety Label",
      "type": "string"
    },
    "safety_evidence": {
      "items": {
        "type": "string"
      },
      "title": "Safety Evidence",
      "type": "array"
    },
    "corrections_needed": {
      "items": {
        "$ref": "#/$defs/JudgeCorrection"
      },
      "title": "Corrections Needed",
      "type": "array"
    },
    "diagnostic_labels": {
      "items": {
        "type": "string"
      },
      "title": "Diagnostic Labels",
      "type": "array"
    },
    "judge_notes": {
      "default": "",
      "title": "Judge Notes",
      "type": "string"
    },
    "human_review_required": {
      "default": false,
      "title": "Human Review Required",
      "type": "boolean"
    }
  },
  "required": [
    "trajectory_id"
  ],
  "title": "JudgeVerdictResponse",
  "type": "object"
}